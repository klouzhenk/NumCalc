@page "/reset-password"

@using Microsoft.AspNetCore.Components.Forms
@using NumCalc.UI.Shared.Layouts
@using NumCalc.UI.Shared.Components

@layout AuthLayout
@inherits BasePage<ResetPassword>

<div class="page-wrapper page__auth">
    <div class="auth-form">
        <div class="auth-form__header">
            <div class="auth-form__logo"><SvgIcon Name="logos-logo-full"/></div>
            <LanguageSwitch/>
        </div>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <p class="auth-form__notice">@Localizer["ResetTokenMissing"]</p>
        }
        else
        {
            <p class="auth-form__notice">@Localizer["ResetPasswordIntro"]</p>

            <EditForm Model="ResetPasswordModel" OnValidSubmit="OnResetPasswordSubmit">
                <DataAnnotationsValidator/>

                <div class="auth-form__field">
                    <label>@Localizer["NewPassword"]</label>
                    <InputText @bind-Value="ResetPasswordModel.NewPassword" type="password" class="input" placeholder="@Localizer["NewPassword"]"/>
                    <ValidationMessage For="@(() => ResetPasswordModel.NewPassword)"/>
                </div>

                <div class="auth-form__field">
                    <label>@Localizer["ConfirmNewPassword"]</label>
                    <InputText @bind-Value="ResetPasswordModel.ConfirmPassword" type="password" class="input" placeholder="@Localizer["ConfirmNewPassword"]"/>
                    <ValidationMessage For="@(() => ResetPasswordModel.ConfirmPassword)"/>
                </div>

                <button type="submit" class="button button--primary">@Localizer["ResetPasswordSubmit"]</button>
            </EditForm>
        }

        <div class="auth-form__footer">
            <p> <a href="/login">@Localizer["BackToLogin"]</a> </p>
        </div>
    </div>
</div>