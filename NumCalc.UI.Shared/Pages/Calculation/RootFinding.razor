@using NumCalc.Shared.DTOs.RootFinding
@using NumCalc.Shared.Enums.RootFinding
@using NumCalc.UI.Shared.Enums.Roots
@using NumCalc.UI.Shared.Components
@using NumCalc.UI.Shared.Models.User.Enums
@using NumCalc.UI.Shared.Utils

@inherits CalculationPage<RootFinding>

@page "/root-finding"

<div class="page-wrapper page-wrapper__calculation page__root-finding">
    <div class="root-finding__form-wrapper">
        <div class="page__filters-container">
            <Switch TItem="AnalysisMode"
                    Data="@(Enum.GetValues<AnalysisMode>())"
                    @bind-Value="Mode"
                    @bind-Value:after="OnParametersChanged"
                    TextField="@(item => Localizer[item.ToString()])"
                    Label="@Localizer["AnalysisMode"]" />

            @switch (Mode)
            {
                case AnalysisMode.Single:
                    <Dropdown TItem="RootFindingMethod"
                              Data="@(Enum.GetValues<RootFindingMethod>())"
                              @bind-Value="_formData.Method"
                              @bind-Value:after="OnParametersChanged"
                              TextField="@(item => Localizer[item.ToString()])"
                              Label="@Localizer["Method"]"/>
                    break;
                case AnalysisMode.Benchmark:
                    <Dropdown TItem="RootFindingMethod"
                              Data="@(Enum.GetValues<RootFindingMethod>())"
                              MultiSelect="true"
                              @bind-SelectedItems="_benchmarkMethods"
                              @bind-SelectedItems:after="OnParametersChanged"
                              TextField="@(item => Localizer[item.ToString()])"
                              Label="@Localizer["Method"]"/>
                    break;
                default:
                    <span>ThereIsNoDropdownForThisMode</span>
                    break;
            }
        </div>
        <div class="root-finding__form">
            <div class="input-section__wrapper">
                <MathInput Label="@Localizer["Expression"]"
                           @bind-Value="_formData.FunctionExpression"
                           @ref="_mathInputComponent"
                           OnInput="OnParametersChanged"/>
            </div >
            <div class="input-section__wrapper">
                <Tooltip>
                    <Content>
                        <div class="input-group">
                            <label class="input-group__label">
                                @(Mode is AnalysisMode.Single && _formData.Method is RootFindingMethod.Newton
                                    ? Localizer["InitialGuess"]
                                    : Localizer["StartPoint"])
                            </label>
                            <input type="number" class="input-group__input" step="any"
                                   @bind="_formData.StartPoint"
                                   @bind:event="oninput"
                                   @bind:after="OnParametersChanged" />
                        </div>
                    </Content>
                    <Hint>
                        @if (Mode is AnalysisMode.Single && _formData.Method is RootFindingMethod.Newton)
                        {
                            <span>@Localizer["Hint_InitialGuess"]</span>
                        }
                        else
                        {
                            <span>@Localizer["Hint_BracketingLowerBound"]</span>
                        }
                    </Hint>
                </Tooltip>

                @if (!(Mode is AnalysisMode.Single && _formData.Method is RootFindingMethod.Newton))
                {
                    <Tooltip>
                        <Content>
                            <div class="input-group">
                                <label class="input-group__label">@Localizer["EndPoint"]</label>
                                <input type="number" class="input-group__input" step="any"
                                       @bind="_formData.EndPoint"
                                       @bind:event="oninput"
                                       @bind:after="OnParametersChanged" />
                            </div>
                        </Content>
                        <Hint>@Localizer["Hint_UpperBound"]</Hint>
                    </Tooltip>
                }

                <Tooltip>
                    <Content>
                        <div class="input-group">
                            <label class="input-group__label">@Localizer["Tolerance"]</label>
                            <input type="number" class="input-group__group" step="0.00001"
                               @bind="_formData.Tolerance"
                               @bind:event="oninput"
                               @bind:after="OnParametersChanged" />
                        </div>
                    </Content>
                    <Hint>@Localizer["Hint_RootTolerance"]</Hint>
                </Tooltip>
            </div>
            <div class="form-actions">
                <button class="button button--primary" @onclick="Calculate">@Localizer["Calculate"]</button>
                @if (Mode is AnalysisMode.Single && Result is not null)
                {
                    <button class="button button--secondary" @onclick="ExportPdfAsync">@Localizer["ExportPdf"]</button>
                }
            </div>
        </div>
    </div>
    
    <ResultPanel HasResult="Result is not null || ComparisonResult is not null">
        <Header>
            @if (Mode is AnalysisMode.Single && Result is not null)
            {
                <span>@Localizer["Root"] = @Result.Root.FormatResult(_formData.Tolerance)</span>
                <span>@Localizer["ExecutionTime"] = @Result.ExecutionTimeMs.FormatResult() @Localizer["ms"]</span>
                <span>@Localizer["Iterations"] = @Result.Iterations</span>
            }
            else
            {
                <span>@Localizer["Benchmark"]</span>
            }
        </Header>
        <ChartContent>
            <div class="chart__container">
                <div class="chart" id="@ChartContainerId" style="display: @(IsChartVisible ? "block" : "none");"></div>
                <span class="remark" style="display: @(IsChartVisible ? "none" : "flex");">@Localizer["ClickCalculateToViewResult"]</span>
            </div>
        </ChartContent>
        <ResultContent>
            @if (Mode is AnalysisMode.Single)
            {
                <SolutionStepsList Steps="Result?.SolutionSteps" />
            }
            else if (ComparisonResult?.Results is { Count: > 0 })
            {
                <ComparisonResultList TItem="BenchmarkResultDto"
                                      Items="ComparisonResult.Results"
                                      IsBest="@(item => item.Method == ComparisonResult.BestMethod)">
                    <ItemTemplate Context="benchmarkResult">
                        <span class="comparison-result__item-title">@Localizer[benchmarkResult.Method.ToString()]</span>
                        <div class="comparison-result__item-text">
                            @{
                                var root = benchmarkResult.Root.FormatResult(_formData.Tolerance);
                            }
                            <span class="comparison-result__item-subtitle">@Localizer["Root"]</span>: @root &nbsp;|&nbsp;
                            <span class="comparison-result__item-subtitle">@Localizer["Iterations"]</span>: @benchmarkResult.Iterations &nbsp;|&nbsp;
                            <span class="comparison-result__item-subtitle">@Localizer["ExecutionTime"]</span>: @benchmarkResult.ExecutionTimeMs.FormatResult() @Localizer["ms"]
                        </div>
                    </ItemTemplate>
                </ComparisonResultList>
            }
        </ResultContent>
    </ResultPanel>
</div>

<SavedInputDataPanel Type="CalculationType.RootFinding"
                     OnSave="SaveInputAsync"
                     OnLoad="LoadFromJsonAsync" />