@page "/forgot-password"
@using NumCalc.UI.Shared.Layouts
@using NumCalc.UI.Shared.Components
@using Microsoft.AspNetCore.Components.Forms
@layout AuthLayout
@inherits BasePage<ForgotPassword>

<div class="page-wrapper page__auth">
    <div class="auth-form">
        <div class="auth-form__header">
            <div class="auth-form__logo"> <SvgIcon Name="logos-logo-full"/> </div>
            <LanguageSwitch/>
        </div>

        @if (!Submitted)
        {
            <p class="auth-form__notice">@Localizer["ForgotPasswordIntro"]</p>

            <EditForm Model="ForgotPasswordModel" OnValidSubmit="OnForgotPasswordSubmit">
                <DataAnnotationsValidator/>

                <div class="auth-form__field">
                    <label>@Localizer["Email"]</label>
                    <InputText @bind-Value="ForgotPasswordModel.Email" type="email" class="input" placeholder="@Localizer["Email"]"/>
                    <ValidationMessage For="@(() => ForgotPasswordModel.Email)"/>
                </div>

                <button type="submit" class="button button--primary">@Localizer["SendResetLink"]</button>
            </EditForm>
        }
        else
        {
            <p class="auth-form__notice">@Localizer["ForgotPasswordSubmittedNotice"]</p>
        }

        <div class="auth-form__footer">
            <p><a href="/login">@Localizer["BackToLogin"]</a></p>
        </div>
    </div>
</div>