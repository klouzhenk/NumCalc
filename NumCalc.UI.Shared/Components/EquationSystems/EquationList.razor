@using NumCalc.UI.Shared.Components

@if (Size > 1)
{
    <div class="equation-list">
        @for (var i = 0; i < Size; i++)
        {
            var index = i;
            <div class="equation-list__row">
                <span class="equation-list__label">g<sub>@(index + 1)</sub>(x)</span>

                <Tooltip>
                    <Content>
                        <MathInput @ref="MathInputs[index]" Placeholder="@($"e.g. {(index % 2 == 0 ? "cos" : "sin")}(x{((index + 1) % Size) + 1})")" />
                    </Content>
                    <Hint>@((MarkupString)string.Format(Localizer["Hint_IterationFunction"].Value, index + 1))</Hint>
                </Tooltip>

                <Tooltip>
                    <Content>
                        <div class="equation-list__guess">
                            <span>x<sub>@(index + 1)</sub><sup>0</sup> =</span>
                            <input type="number" step="any"
                                   value="@InitialGuess[index]"
                                   @onchange="e => { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) InitialGuess[index] = v; }" />
                        </div>
                    </Content>
                    <Hint>@((MarkupString)string.Format(Localizer["Hint_SystemInitialGuess"].Value, index + 1))</Hint>
                </Tooltip>
            </div>
        }

        <div class="equation-list__params">
            <Tooltip>
                <Content>
                    <div class="input-group">
                        <label class="input-group__label">Tolerance</label>
                        <input type="number" step="any" class="input-group__input"
                               @bind="Tolerance" />
                    </div>
                </Content>
                <Hint>@Localizer["Hint_Tolerance"]</Hint>
            </Tooltip>

            <Tooltip>
                <Content>
                    <div class="input-group">
                        <label class="input-group__label">Max iterations</label>
                        <input type="number" class="input-group__input"
                               @bind="MaxIterations" />
                    </div>
                </Content>
                <Hint>Maximum number of iterations before stopping.</Hint>
            </Tooltip>
        </div>
    </div>
}
