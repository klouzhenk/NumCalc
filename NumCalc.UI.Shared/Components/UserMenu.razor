@using NumCalc.UI.Shared.Enums
@using NumCalc.UI.Shared.Resources

<div class="user-menu @(_isOpen ? "user-menu--open" : "")">
    <button class="user-menu__trigger" @onclick="Toggle" @onclick:stopPropagation>
        <SvgIcon Name="user"/>
    </button>

    <div class="user-menu__overlay" @onclick="Close"></div>

    <div class="user-menu__popover" @onclick:stopPropagation>
        <ul class="user-menu__list hoverable">
            @if (AuthStateService.IsAuthenticated)
            {
                <li class="user-menu__item" @onclick="GoToAccountSettings">
                    <SvgIcon Name="user-setting"/>
                    <span>@Localizer[nameof(Localization.AccountSettings)]</span>
                </li>
                <li class="user-menu__item" @onclick="GoToDashboard">
                    <SvgIcon Name="statistics"/>
                    <span>@Localizer[nameof(Localization.UserDashboard)]</span>
                </li>
                <li class="user-menu__item" @onclick="OpenLanguageModal">
                    <SvgIcon Name="language"/>
                    <span>@Localizer[nameof(Localization.Language)]</span>
                </li>
                <li class="user-menu__item" @onclick="OpenThemeModal">
                    <SvgIcon Name="theme"/>
                    <span>@Localizer[nameof(Localization.Theme)]</span>
                </li>
                <li class="user-menu__item" @onclick="Logout">
                    <SvgIcon Name="logout"/>
                    <span>@Localizer[nameof(Localization.Logout)]</span>
                </li>
            }
            else
            {
                <li class="user-menu__item" @onclick="GoToLogin">
                    <SvgIcon Name="login"/>
                    <span>@Localizer[nameof(Localization.Login)]</span>
                </li>
                <li class="user-menu__item" @onclick="OpenLanguageModal">
                    <SvgIcon Name="language"/>
                    <span>@Localizer[nameof(Localization.Language)]</span>
                </li>
                <li class="user-menu__item" @onclick="OpenThemeModal">
                    <SvgIcon Name="theme"/>
                    <span>@Localizer[nameof(Localization.Theme)]</span>
                </li>
            }
        </ul>
    </div>
</div>

<BaseModal @ref="_languageModal"
           Subtitle="@Localizer[nameof(Localization.ChooseLanguage)]"
           CssClass="modal--user-settings">
    <BodyContent>
        <button class="button @(CultureService.CurrentCulture == "en" ? "button--primary" : "button--outline")"
                @onclick='() => SelectCulture("en")'>@Localizer["English"]</button>
        <Divider Text="@Localizer[nameof(Localization.Or)]"/>
        <button class="button @(CultureService.CurrentCulture == "uk" ? "button--primary" : "button--outline")"
                @onclick='() => SelectCulture("uk")'>@Localizer["Ukrainian"]</button>
    </BodyContent>
</BaseModal>

<BaseModal @ref="_themeModal"
           Subtitle="@Localizer[nameof(Localization.ChooseTheme)]"
           CssClass="modal--user-settings">
    <BodyContent>
        <button class="button @(_themeMode is ThemeMode.Light ? "button--primary" : "button--outline")"
                @onclick="() => ToggleTheme(ThemeMode.Light)">@Localizer["Light"]</button>
            <Divider Text="@Localizer[nameof(Localization.Or)]"/>
        <button class="button @(_themeMode is ThemeMode.Dark ? "button--primary" : "button--outline")"
                @onclick="() => ToggleTheme(ThemeMode.Dark)">@Localizer["Dark"]</button>
    </BodyContent>
</BaseModal>
