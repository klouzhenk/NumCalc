@using NumCalc.Shared.Enums.Differentiation
@using NumCalc.UI.Shared.Components
@using NumCalc.UI.Shared.Enums.Differentiation

@if (Method is DifferentiationMethod.FiniteDifferences)
{
    <div class="input-section__wrapper">
        <Tooltip>
            <Content>
                <MathInput Label="f(x)" @ref="_mathInput" />
            </Content>
            <Hint>@Localizer["Hint_DiffFunction"]</Hint>
        </Tooltip>
    </div>

    <div class="input-section__wrapper">
        <Tooltip>
            <Content>
                <div class="input-group">
                    <label class="input-group__label">x*</label>
                    <input type="number" step="any" class="input-group__input" @bind="_queryPoint" />
                </div>
            </Content>
            <Hint>@Localizer["Hint_QueryPoint"]</Hint>
        </Tooltip>
        
        <Tooltip>
            <Content>
                <Dropdown TItem="int"
                          Label="@Localizer["DerivativeOrder"]"
                          Data="@(new[] { 1, 2 })"
                          @bind-Value="_derivativeOrder"
                          TextField="@(n => n == 1 ? "1st" : "2nd")" />
            </Content>
            <Hint>@Localizer["Hint_DerivativeOrder"]</Hint>
        </Tooltip>
        
        <Tooltip>
            <Content>
                <div class="input-group">
                    <label class="input-group__label">@Localizer["StepSize"] (h)</label>
                    <input type="number" step="any" class="input-group__input" @bind="_stepSize" />
                </div>
            </Content>
            <Hint>@Localizer["Hint_StepSize"]</Hint>
        </Tooltip>
    </div>
}
else
{

    <div class="input-section__wrapper">
        @if (Mode is DifferentiationInputMode.Function)
        {
            <Tooltip>
                <Content>
                    <MathInput Label="f(x)" @ref="_mathInput"/>
                </Content>
                <Hint>@Localizer["Hint_DiffFunctionLagrange"]</Hint>
            </Tooltip>
        }
        <Tooltip>
            <Content>
                <Dropdown TItem="int"
                          Label="@Localizer["DerivativeOrder"]"
                          Data="@(new[] { 1, 2 })"
                          @bind-Value="_derivativeOrder"
                          TextField="@(n => n == 1 ? "1st" : "2nd")"/>
            </Content>
            <Hint>@Localizer["Hint_DerivativeOrder"]</Hint>
        </Tooltip>
        <Tooltip>
            <Content>
                <div class="input-group">
                    <label class="input-group__label">x*</label>
                    <input type="number" step="any" class="input-group__input" @bind="_queryPoint"/>
                </div>
            </Content>
            <Hint>@Localizer["Hint_QueryPoint"]</Hint>
        </Tooltip>
    </div>

    <NodeTable ShowY="@(Mode is DifferentiationInputMode.RawData)" @ref="_nodeTable" />
}
