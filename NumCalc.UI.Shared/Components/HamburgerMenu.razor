@using NumCalc.UI.Shared.Enums
@using NumCalc.UI.Shared.Utils

<button class="hamburger @(IsMenuOpen ? "hamburger--active" : "")" @onclick="ToggleMenu">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
</button>

<div class="hamburger-menu__overlay @(IsMenuOpen ? "visible" : "")" @onclick="CloseMenu"></div>

<aside class="hamburger-menu @(IsMenuOpen ? "open" : "")">
    <ul class="hamburger-menu__list hoverable">
        @foreach (var item in NavigationUtils.NavigationItems)
        {
            <li class="hamburger-menu__row" @onclick="() => OnListItemClick(item.Key)">
                <span class="hamburger-menu__row-label">@Localizer[item.Key.ToString()]</span>
                <button class="topic-info__trigger topic-info__trigger--icon"
                        @onclick="() => OpenTopicInfo(item.Key)"
                        @onclick:stopPropagation>?</button>
            </li>
        }
    </ul>
</aside>
