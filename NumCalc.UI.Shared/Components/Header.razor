@using NumCalc.UI.Shared.Enums
@using NumCalc.UI.Shared.Resources

<header>
    <div class="header__logo" @onclick="OnHeaderLogoClick">
        <SvgIcon Name="logos-logo-full" />
    </div>

    <div class="header__actions">
        @if (CurrentNavItem.HasValue)
        {
            <button class="topic-info__trigger link-underline" @onclick="OpenTopicInfo">
                @Localizer[nameof(Localization.AboutThisTopic)]
            </button>
        }

        <UserMenu />
    </div>
</header>
