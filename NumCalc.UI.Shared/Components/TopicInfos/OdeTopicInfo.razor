@inherits TopicInfoComponentBase

<TopicInfo Title="@Localize("Ordinary Differential Equations", "Звичайні диференціальні рівняння")"
           Subtitle="@Localize("Solve y' = f(x, y) with initial condition y(x₀) = y₀", "Розв'язання y' = f(x, y) з початковою умовою y(x₀) = y₀")">
    <p class="topic-info__overview">
        @Localize(
            "ODE solvers advance the solution from the initial condition $(x_0, y_0)$ step by step until the target $x$. Step size $h$ controls accuracy and computational cost.",
            "Розв'язувачі ЗДР просувають розв'язок від початкової умови $(x_0, y_0)$ крок за кроком до цільового $x$. Крок $h$ керує точністю та обчислювальною вартістю."
        )
    </p>

    <div class="topic-info__cards">
        <div class="topic-info__card">
            <h3>@Localize("Euler Method", "Метод Ейлера")</h3>
            <div class="topic-info__formula">$$y_{n+1} = y_n + h \cdot f(x_n, y_n)$$</div>
            <p>
                @Localize(
                    "Simplest one-step method: extrapolates the tangent at each point. $O(h)$ local truncation error. Good for a first approximation.",
                    "Найпростіший однокроковий метод: екстраполює дотичну в кожній точці. Локальна похибка усічення $O(h)$. Підходить для першого наближення."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Low accuracy; may be unstable for stiff equations with large $h$.",
                    "Низька точність; може бути нестійким для жорстких рівнянь при великих $h$."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Euler Improved (Heun)", "Ейлер покращений (Хьюна)")</h3>
            <div class="topic-info__formula">
                $$\tilde{y}_{n+1} = y_n + h f(x_n, y_n)$$
                $$y_{n+1} = y_n + \frac{h}{2}\bigl[f(x_n, y_n) + f(x_{n+1}, \tilde{y}_{n+1})\bigr]$$
            </div>
            <p>
                @Localize(
                    "Predictor-corrector variant of Euler. $O(h^2)$ accuracy — a significant improvement with only one extra function evaluation per step.",
                    "Варіант Ейлера «прогноз-корекція». Точність $O(h^2)$ — значне покращення коштом лише одного додаткового обчислення функції на кроці."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Still unstable for stiff problems; requires $h$ small enough.",
                    "Все ще нестійкий для жорстких задач; потребує достатньо малого $h$."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Runge-Kutta 2 (RK2)", "Рунге-Кутта 2 (RK2)")</h3>
            <div class="topic-info__formula">
                $$k_1 = h f(x_n, y_n), \quad k_2 = h f\!\left(x_n+\tfrac{h}{2},\, y_n+\tfrac{k_1}{2}\right)$$
                $$y_{n+1} = y_n + k_2$$
            </div>
            <p>
                @Localize(
                    "Midpoint variant of RK2: evaluates the slope at the midpoint of the step. $O(h^2)$ accuracy with only two function evaluations per step.",
                    "Варіант RK2 із серединною точкою: обчислює нахил у середині кроку. Точність $O(h^2)$ при лише двох обчисленнях функції на кроці."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "$O(h^2)$ accuracy; use RK4 for higher precision requirements.",
                    "Точність $O(h^2)$; для вищої точності використовуйте RK4."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Runge-Kutta 4 (RK4)", "Рунге-Кутта 4 (RK4)")</h3>
            <div class="topic-info__formula">
                $$k_1 = hf(x_n,y_n),\quad k_2 = hf\!\left(x_n+\tfrac{h}{2}, y_n+\tfrac{k_1}{2}\right)$$
                $$k_3 = hf\!\left(x_n+\tfrac{h}{2}, y_n+\tfrac{k_2}{2}\right),\quad k_4 = hf(x_n+h,y_n+k_3)$$
                $$y_{n+1} = y_n + \tfrac{1}{6}(k_1 + 2k_2 + 2k_3 + k_4)$$
            </div>
            <p>
                @Localize(
                    "The classic standard solver. $O(h^4)$ accuracy per step. Four evaluations of $f$ per step give excellent accuracy for most smooth ODEs.",
                    "Класичний стандартний розв'язувач. Точність $O(h^4)$ на кроці. Чотири обчислення $f$ на кроці дають чудову точність для більшості гладких ЗДР."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Four evaluations per step; not suitable for very stiff equations without adaptive step control.",
                    "Чотири обчислення на кроці; не підходить для дуже жорстких рівнянь без адаптивного керування кроком."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Picard Successive Approximation", "Послідовні наближення Пікара")</h3>
            <div class="topic-info__formula">$$y^{(k+1)}(x) = y_0 + \int_{x_0}^{x} f\!\left(t, y^{(k)}(t)\right)\,dt$$</div>
            <p>
                @Localize(
                    "Builds symbolic approximations by integrating $f$ iteratively starting from $y^{(0)}(x) = y_0$. Returns a closed-form polynomial expression.",
                    "Будує символьні наближення, ітеративно інтегруючи $f$ починаючи з $y^{(0)}(x) = y_0$. Повертає замкнутий вираз у вигляді полінома."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Converges only near $x_0$; higher order on wide intervals diverges. Symbolic computation is slow for large order.",
                    "Збігається лише поблизу $x_0$; вищі порядки на широких інтервалах розбігаються. Символьні обчислення повільні для великих порядків."
                )
            </p>
        </div>
    </div>
</TopicInfo>
