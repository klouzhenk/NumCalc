@inherits TopicInfoComponentBase

<TopicInfo Title="@Localize("Function Optimization", "Оптимізація функцій")"
           Subtitle="@Localize("Find the minimum of f(x) or f(x₁, x₂, …)", "Пошук мінімуму f(x) або f(x₁, x₂, …)")">
    <p class="topic-info__overview">
        @Localize(
            "Optimization locates the point $x^*$ that minimizes or maximizes $f(x)$. One-dimensional methods search an interval $[a, b]$ assuming unimodal $f$; gradient descent handles multi-dimensional cases.",
            "Оптимізація знаходить точку $x^*$, у якій функція $f(x)$ досягає мінімуму або максимуму. Одновимірні методи шукають на інтервалі $[a, b]$ за умови унімодальної $f$; градієнтний спуск працює з багатовимірними випадками."
        )
    </p>

    <div class="topic-info__cards">
        <div class="topic-info__card">
            <h3>@Localize("Uniform Search", "Рівномірний пошук")</h3>
            <div class="topic-info__formula">$$x^* \approx \arg\min_{x_i \in \{a,\,a+h,\,a+2h,\ldots,b\}} f(x_i), \quad h = \frac{b-a}{n-1}$$</div>
            <p>
                @Localize(
                    "Evaluates $f$ at $n$ equally-spaced points and returns the minimum or maximum. Simple and parallelizable but accuracy depends entirely on $n$.",
                    "Обчислює $f$ у $n$ рівновіддалених точках і повертає мінімум або максимум. Простий і добре розпаралелюється, але точність повністю залежить від $n$."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Only finds the global extremum if $f$ is unimodal; misses narrow peaks/valleys with small $n$.",
                    "Знаходить глобальний екстремум лише для унімодальної $f$; пропускає вузькі піки/западини при малому $n$."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Golden Section Search", "Золотий перетин")</h3>
            <div class="topic-info__formula">$$\varphi = \frac{\sqrt{5} - 1}{2} \approx 0.618, \quad [a,b] \to [a,b'] \text{ with } |b'-a'| = \varphi|b-a|$$</div>
            <p>
                @Localize(
                    "Narrows the search interval by the golden ratio at each step without re-evaluating previously computed points. Works for both minimum and maximum. Logarithmic convergence.",
                    "На кожному кроці звужує інтервал пошуку у пропорції золотого перетину без повторного обчислення вже відомих точок. Працює як для мінімуму, так і для максимуму. Логарифмічна швидкість збіжності."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Assumes $f$ is unimodal on $[a, b]$; fails for multi-modal functions.",
                    "Передбачає унімодальну $f$ на $[a, b]$; не працює для багатомодальних функцій."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Gradient Descent", "Градієнтний спуск")</h3>
            <div class="topic-info__formula">$$\mathbf{x}^{(k+1)} = \mathbf{x}^{(k)} - \alpha \nabla f(\mathbf{x}^{(k)})$$</div>
            <p>
                @Localize(
                    "Moves along the negative gradient direction with step $\\alpha$ (learning rate). Works for smooth multi-dimensional functions; auto-detects variables.",
                    "Рухається у напрямку антиградієнта з кроком $\\alpha$ (швидкість навчання). Працює для гладких багатовимірних функцій; змінні визначаються автоматично."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Converges to a local minimum; step size $\\alpha$ must be chosen carefully to avoid divergence.",
                    "Збігається до локального мінімуму; крок $\\alpha$ слід обирати обережно, щоб уникнути розбіжності."
                )
            </p>
        </div>
    </div>
</TopicInfo>
