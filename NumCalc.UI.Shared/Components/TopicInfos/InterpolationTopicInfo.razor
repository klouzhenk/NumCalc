@inherits TopicInfoComponentBase

<TopicInfo Title="@Localize("Interpolation", "Інтерполяція")"
           Subtitle="@Localize("Estimate f(x) between known data points", "Оцінка f(x) між відомими точками")">
    <p class="topic-info__overview">
        @Localize(
            "Interpolation constructs a function that passes exactly through a set of data points $(x_i, y_i)$. The resulting polynomial or spline can then be evaluated at any query point $x^*$ within the data range.",
            "Інтерполяція будує функцію, що проходить точно через задані точки $(x_i, y_i)$. Отриманий поліном або сплайн можна обчислити в будь-якій точці $x^*$ у межах діапазону даних."
        )
    </p>

    <div class="topic-info__cards">
        <div class="topic-info__card">
            <h3>@Localize("Newton Divided Differences", "Поліном Ньютона (розділені різниці)")</h3>
            <div class="topic-info__formula">$$P(x) = [y_0] + [y_0,y_1](x-x_0) + [y_0,y_1,y_2](x-x_0)(x-x_1)+\cdots$$</div>
            <p>
                @Localize(
                    "Builds the interpolating polynomial incrementally using divided differences. Adding a new data point only requires one additional term.",
                    "Будує інтерполяційний поліном поступово за допомогою розділених різниць. Додавання нової точки потребує лише одного додаткового члена."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "High-degree polynomials oscillate at the endpoints (Runge's phenomenon).",
                    "Поліноми високого степеня осцилюють біля країв відрізка (явище Рунге)."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Lagrange Polynomial", "Поліном Лагранжа")</h3>
            <div class="topic-info__formula">$$P(x) = \sum_{i=0}^{n} y_i \prod_{j \neq i} \frac{x - x_j}{x_i - x_j}$$</div>
            <p>
                @Localize(
                    "Expresses the interpolating polynomial as a weighted sum of basis polynomials $L_i(x)$. Each $L_i(x_j) = \\delta_{ij}$.",
                    "Подає інтерполяційний поліном як зважену суму базисних поліномів $L_i(x)$. При цьому $L_i(x_j) = \\delta_{ij}$."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Runge's phenomenon; recomputing the whole polynomial when adding a node.",
                    "Явище Рунге; додавання нового вузла потребує перерахунку всього полінома."
                )
            </p>
        </div>

        <div class="topic-info__card">
            <h3>@Localize("Cubic Spline", "Кубічний сплайн")</h3>
            <div class="topic-info__formula">$$S_i(x) = a_i + b_i(x-x_i) + c_i(x-x_i)^2 + d_i(x-x_i)^3$$</div>
            <p>
                @Localize(
                    "Piecewise cubic polynomials joined with $C^2$ continuity. Avoids Runge's phenomenon and produces smooth, visually appealing curves.",
                    "Кусково-кубічні поліноми, з'єднані з неперервністю $C^2$. Уникає явища Рунге і дає плавні, візуально приємні криві."
                )
            </p>
            <p class="topic-info__limitation">
                @Localize(
                    "Requires solving a tridiagonal system; extrapolation outside the data range is unreliable.",
                    "Потребує розв'язання тридіагональної системи; екстраполяція за межами діапазону даних ненадійна."
                )
            </p>
        </div>
    </div>
</TopicInfo>
