<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DefaultPythonItems>true</DefaultPythonItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSnakes.Runtime" Version="2.0.0-beta.319" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Scripts\**\*.py">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Scripts\requirements.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NumCalc.Shared\NumCalc.Shared.csproj" />
    </ItemGroup>

</Project>
