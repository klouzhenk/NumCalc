# Copy this file to .env and fill in real values. .env is gitignored.
# Required for `docker compose up`.

# ---- SQL Server (db service) ----
# Used as the SA account password AND embedded in the User API connection string.
# Must satisfy SQL Server policy: at least 8 chars, mixed case, digits, symbols.
SA_PASSWORD=ChangeMe_Strong_Password_123!

# ---- User API ----
# JWT signing key. Generate with e.g.: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-base64-32-byte-key

# Web UI public URL embedded into password-reset emails.
# Local: http://localhost:8080
# Dev:   https://numcalc.dev
# Prod:  https://numcalc.prod
WEB_BASE_URL=http://localhost:8080

# ---- Gmail SMTP (User API password-reset emails) ----
# Use a Gmail App Password (not your account password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mailer@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_ADDRESS=your-mailer@gmail.com
SMTP_FROM_NAME=NumCalc
SMTP_USE_SSL=true

# ---- Gemini OCR (Calculation API) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
